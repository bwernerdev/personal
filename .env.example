# Copie para .env SOMENTE se for rodar com o Notion no seu computador.
# Na Vercel, cadastre estas variáveis no painel ou com `npx vercel env add`.

# Token da integração interna do Notion (começa com ntn_ ou secret_). NUNCA vai para o git.
NOTION_TOKEN=

# Código que o app pede ao abrir. Escolha algo longo; protege a API pública.
APP_CODE=

# Ajuda do Claude no chat (OPCIONAL). Sem a chave, o chat usa só as regras. NUNCA vai para o git.
# Crie a chave em https://console.anthropic.com/ . Cada uso custa centavos (ver docs/README.md).
ANTHROPIC_API_KEY=

# Opcionais (já têm o valor atual como padrão no código):
# ANTHROPIC_MODEL=claude-opus-5-5      # troque por claude-haiku-5-5 para gastar bem menos
# LLM_LIMITE_POR_HORA=30               # máximo de usos do Claude por hora, por instância da Vercel
# NOTION_ROTINA_DS=245c3a99-83e4-4cfc-8dcb-b9c82a1de889
# NOTION_TREINOS_DS=ecbfc1e7-ae29-4050-8362-ecd85288b870
