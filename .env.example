# Copie para .env SOMENTE se for rodar com o Notion no seu computador.
# Na Vercel, cadastre estas variáveis no painel ou com `npx vercel env add`.

# Token da integração interna do Notion (começa com ntn_ ou secret_). NUNCA vai para o git.
NOTION_TOKEN=

# Código que o app pede ao abrir. Escolha algo longo; protege a API pública.
APP_CODE=

# Ajuda de IA no chat (OPCIONAL). Sem nenhuma chave, o chat usa só as regras. NUNCA vai para o git.
# Gemini (Google) tem plano GRÁTIS, sem cartão: crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Alternativa paga: Claude (https://console.anthropic.com/). Com as duas chaves, vale o Gemini.
ANTHROPIC_API_KEY=

# Opcionais (já têm o valor atual como padrão no código):
# NOTION_FRASES_DS=c88162e2-35d4-4558-9a8f-9ce6f6f72a29   # banco "Frases novas" (frases que as regras não resolvem)
# GEMINI_MODEL=gemini-3.8-flash        # opcional: fixa um modelo (padrão: 3.8 Flash, depois 3.5 Flash-Lite, depois flash-latest)
# ANTHROPIC_MODEL=claude-haiku-5-5     # padrão (o mais barato); claude-opus-5-5 entende mais, mas custa ~25x mais
# LLM_PROVIDER=gemini                  # só para forçar um provedor quando as duas chaves existem
# LLM_LIMITE_POR_HORA=30               # máximo de usos da IA por hora, por instância da Vercel
# NOTION_ROTINA_DS=245c3a99-83e4-4cfc-8dcb-b9c82a1de889
# NOTION_TREINOS_DS=ecbfc1e7-ae29-4050-8362-ecd85288b870
